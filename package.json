{
	"name": "portfolio-v4",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.29.3",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite",
		"build": "pnpm typecheck && vite build && vite build --ssr src/entry-server.tsx && node scripts/prerender.mjs",
		"preview": "vite preview",
		"typecheck": "tsc -b",
		"lint": "biome lint .",
		"format:check": "biome format .",
		"fix": "biome check --write .",
		"check:biome": "biome ci .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "pnpm typecheck && pnpm check:biome && pnpm test",
		"build:og-images": "node scripts/build-og-images.mjs",
		"capture:work-images": "node scripts/capture-work-images.mjs",
		"test:e2e": "playwright test",
		"test:e2e:a11y": "playwright test --grep @a11y",
		"check:dist": "node scripts/check-dist.mjs",
		"render:diagrams": "node scripts/render-diagrams.mjs"
	},
	"dependencies": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@tanstack/react-router": "^1.170.42",
		"@vercel/speed-insights": "^2.0.0",
		"clsx": "^2.1.1",
		"lucide-react": "^1.57.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "1.63.0",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"jsdom": "^30.1.2",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.3",
		"vite": "^7.3.7",
		"vitest": "^5.0.3"
	}
}
