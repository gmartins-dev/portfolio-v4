{
	"name": "portfolio-v4",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.29.3",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite",
		"build": "pnpm typecheck && vite build && vite build --ssr src/entry-server.tsx && node scripts/prerender.mjs",
		"preview": "vite preview",
		"typecheck": "tsc -b",
		"lint": "biome lint .",
		"format:check": "biome format .",
		"fix": "biome check --write .",
		"check:biome": "biome ci .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "pnpm typecheck && pnpm check:biome && pnpm test"
	},
	"dependencies": {
		"@tanstack/react-router": "^1.166.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.577.0",
		"radix-ui": "^1.4.3",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"shadcn": "^4.0.2",
		"tailwind-merge": "^3.5.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@tailwindcss/vite": "^4.2.1",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"tailwindcss": "^4.2.1",
		"typescript": "~5.9.3",
		"vite": "^7.3.1",
		"vitest": "^5.0.3"
	}
}
